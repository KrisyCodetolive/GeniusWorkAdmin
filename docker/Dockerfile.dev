# Image de développement : le code est monté en volume, pas copié
FROM php:8.3-cli-alpine

RUN apk add --no-cache bash git unzip nodejs npm mysql-client \
        libzip libpng libjpeg-turbo freetype libwebp icu-libs \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
        libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev libwebp-dev icu-dev linux-headers \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) pdo_mysql gd zip bcmath pcntl intl exif \
    && pecl install redis && docker-php-ext-enable redis \
    && apk del .build-deps

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Réglages PHP de dev (OPcache activé : le volume Windows est lent)
RUN docker-php-ext-enable opcache \
    && printf '%s\n' \
       memory_limit=512M upload_max_filesize=600M post_max_size=610M \
       opcache.enable=1 opcache.enable_cli=1 opcache.validate_timestamps=1 opcache.revalidate_freq=2 \
       opcache.memory_consumption=256 opcache.max_accelerated_files=30000 \
       realpath_cache_size=4096k realpath_cache_ttl=600 \
       > /usr/local/etc/php/conf.d/dev.ini

WORKDIR /var/www/html
