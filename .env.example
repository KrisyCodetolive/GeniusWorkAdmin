APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Telescope
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=geniuswork
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.genius.ci
MAIL_PORT=587
MAIL_USERNAME=work@genius.ci
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="work@genius.ci"
MAIL_FROM_NAME="Genius Work"

# Configuration pour améliorer la délivrabilité des emails
MAIL_REPLY_TO_ADDRESS="support@genius.ci"
MAIL_REPLY_TO_NAME="Support Genius Work"
MAIL_DKIM_DOMAIN="genius.ci"
MAIL_DKIM_SELECTOR="default"

# Genius Tools API Configuration
GENIUS_TOOLS_API_KEY=
GENIUS_TOOLS_BASE_URL=https://linkqr.genius.ci/api

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuration Orange SMS
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_DEV_PHONE_NUMBER=

# Configuration MTN SMS
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_DEV_PHONE_NUMBER=
MTN_SMS_SENDER_ADDRESS=
MTN_SMS_API_BASE_URL=https://api.mtn.com/v2

# Configuration SMS par défaut
SMS_DEFAULT_PROVIDER=orange

VITE_APP_NAME="${APP_NAME}"
