APP_NAME="Genius Work"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=genius_work
DB_USERNAME=genius
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=votre-domaine.com
SESSION_DOMAIN=votre-domaine.com

# Synchronisation cloud <-> instance locale (vide = désactivée, voir config/sync.php)
# Rôle : cloud sur l'instance en ligne, local sur le serveur de l'entreprise
SYNC_ROLE=cloud
# URL de l'autre instance (sur le cloud : vide si le serveur local n'est pas joignable depuis internet)
SYNC_REMOTE_URL=
# Secret identique sur les deux instances : php -r "echo bin2hex(random_bytes(32));"
SYNC_SECRET=
# Id (uuid) de l'entreprise synchronisée, identique sur les deux instances
SYNC_ENTREPRISE_ID=
# IP autorisées à appeler /api/sync/* (séparées par des virgules, vide = toutes)
SYNC_ALLOWED_IPS=
